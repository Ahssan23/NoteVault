<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NoteVault</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="home.css">
</head>
<body>

<nav>
  <div class="nav-logo">// NoteVault</div>
  <div class="nav-links">
    <a href="#how">How it works</a>
    <a href="#features">Features</a>
  </div>
  <% if(!loggedIn){  %>

    <a href="/login" class="nav-cta">Login</a>
    <a href="/signup" class="nav-cta">Signup</a>
    <%  } %>

</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-glow"></div>
  <div class="hero-eyebrow">Secure File Vaults</div>
  <h1>
    Store.<br>
    <span class="line2">Lock.</span><br>
    <span class="outline">Retrieve.</span>
  </h1>
  <p class="hero-sub">
    Drop your files, get a vault key.<br>
    Come back anytime. No account clutter — just a key.
  </p>
  <div class="hero-actions">
    <a href="/createvault/upload" class="btn-primary">Create a Vault</a>
    <a href="/getVault" class="btn-secondary">Retrieve Files</a>
  </div>
</section>

<!-- TICKER -->
<div class="ticker-wrap">
  <div class="ticker-track">
    <span>Upload</span><span class="accent">→</span>
    <span>Get Vault Key</span><span class="accent">→</span>
    <span>Share or Store</span><span class="accent">→</span>
    <span>Retrieve Anytime</span><span class="accent">→</span>
    <span>Add More Files</span><span class="accent">→</span>
    <span>Encrypted at Rest</span><span class="accent">→</span>
    <span>No Clutter</span><span class="accent">→</span>
    <span>Upload</span><span class="accent">→</span>
    <span>Get Vault Key</span><span class="accent">→</span>
    <span>Share or Store</span><span class="accent">→</span>
    <span>Retrieve Anytime</span><span class="accent">→</span>
    <span>Add More Files</span><span class="accent">→</span>
    <span>Encrypted at Rest</span><span class="accent">→</span>
    <span>No Clutter</span><span class="accent">→</span>
  </div>
</div>

<!-- HOW IT WORKS -->
<div class="section fade-up" id="how">
  <div class="section-label">Process</div>
  <div class="section-title">Three steps.<br>That's it.</div>

  <div class="steps">
    <div class="step">
      <div class="step-num">01</div>
      <div class="step-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#e8ff47" stroke-width="1.8" stroke-linecap="round">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
      </div>
      <h3>Upload your files</h3>
      <p>Drop anything — PDFs, images, docs, spreadsheets. Title your vault and describe what's inside. Everything is encrypted.</p>
      <div class="step-arrow">
        <svg viewBox="0 0 12 12" fill="none" stroke="#e8ff47" stroke-width="2" stroke-linecap="round">
          <polyline points="4 2 8 6 4 10"/>
        </svg>
      </div>
    </div>

    <div class="step">
      <div class="step-num">02</div>
      <div class="step-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#e8ff47" stroke-width="1.8" stroke-linecap="round">
          <rect x="3" y="11" width="18" height="11" rx="2"/>
          <path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
      </div>
      <h3>Get your vault key</h3>
      <p>A unique UUID is generated for your vault. Save it — it's your only way back in.</p>
      <div class="step-arrow">
        <svg viewBox="0 0 12 12" fill="none" stroke="#e8ff47" stroke-width="2" stroke-linecap="round">
          <polyline points="4 2 8 6 4 10"/>
        </svg>
      </div>
    </div>

    <div class="step">
      <div class="step-num">03</div>
      <div class="step-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="#e8ff47" stroke-width="1.8" stroke-linecap="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </div>
      <h3>Retrieve anytime</h3>
      <p>Enter your vault key to pull all your files back. Add more files to an existing vault whenever.</p>
    </div>
  </div>
</div>

<!-- FEATURES -->
<div class="section fade-up" id="features" style="padding-top:0">
  <div class="section-label">Why NoteVault</div>
  <div class="section-title">Built different.</div>

  <div class="features-grid">
    <div class="feature">
      <div class="feature-tag">Storage</div>
      <h3>Any file type</h3>
      <p>Images, PDFs, Word docs, spreadsheets, presentations — if you can make it, we can vault it.</p>
    </div>
    <div class="feature">
      <div class="feature-tag">Simplicity</div>
      <h3>Key-based access</h3>
      <p>No folders. No complex permission trees. One UUID, one vault. Brutally simple, deliberately so.</p>
    </div>
    <div class="feature">
      <div class="feature-tag">Flexible</div>
      <h3>Grow your vault</h3>
      <p>Already have a vault? Add more files to it anytime using the same vault key. No re-upload nonsense.</p>
    </div>
    <div class="feature">
      <div class="feature-tag">Auth</div>
      <h3>Account protected</h3>
      <p>Login and signup powered by JWT. Your vaults are tied to your account — nobody else gets in.</p>
    </div>
  </div>
</div>

    
   
<!-- CTA STRIP -->
<div class="cta-strip">
  <h2>Ready to vault?</h2>
  <h3>No setup. No complexity. Just drop and lock.</h3>
<h3>Create a free account to upload files and access them anytime — no key needed.</h3>

  <a href="/signup" class="btn-dark">Create Free Account</a>
</div>

<!-- FOOTER -->
<footer>
  <div class="footer-logo">// NoteVault</div>
  <div class="footer-links">
    <a href="/upload">Upload</a>
    <a href="/retrieve">Retrieve</a>
    <a href="/login">Login</a>
    <a href="/signup">Signup</a>
  </div>
</footer>

<script>
  // fade-up on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>
</body>
</html>